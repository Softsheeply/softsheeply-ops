<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#CC111827"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_shift_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌙 Night shift"
            android:textColor="#E8EAF6"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Updated 2:30 AM"
            android:textColor="#8892A4"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_sleep_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SLEEP WINDOW"
        android:textColor="#8892A4"
        android:textSize="9sp"
        android:letterSpacing="0.12"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_sleep_window"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="8:00 AM → 4:00 PM"
        android:textColor="#3D5AFE"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:fontWeight="700" />

    <TextView
        android:id="@+id/widget_caffeine"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☕ Last coffee: 2:00 AM"
        android:textColor="#FFAB40"
        android:textSize="11sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
